{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "module": "preserve",
    "noEmit": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@plone/volto/*": ["../../core/packages/volto/src/*"],
      "volto-aemet/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "src/components/Aemet/WeatherCurrent.test.js",
    "src/config/blocks.test.js",
    "src/config/settings.test.js",
    "src/hooks/useWeatherData.test.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    "public",
    "coverage",
    "**/*.test.{js,jsx,ts,tsx}",
    "**/*.spec.{js,jsx,ts,tsx}",
    "**/*.stories.{js,jsx,ts,tsx}"
  ]
}
